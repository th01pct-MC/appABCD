rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if authenticated user is the designated Admin Teacher
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'th01pct@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // App Settings (Teacher Name, Logo, Notification Config)
    match /settings/{settingId} {
      allow read: if true; // Public for school branding & logo
      allow write: if isAdmin();
    }

    // Questions Bank
    // CRITICAL SECURITY: Only Admin can read raw question bank containing secret answers.
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Quizzes (Tests)
    match /quizzes/{quizId} {
      // Students can read quiz configuration if it is active
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student Quiz Attempts
    match /quizAttempts/{attemptId} {
      // Anyone can create an attempt to start a quiz
      allow create: if true;
      // Student can update their attempt during test (answering questions, tab counts)
      allow update: if true;
      // Admin can read all attempts and delete if needed
      allow read, delete: if isAdmin();
    }

    // Student Quiz Answers (Autosaved & Server Evaluated)
    match /quizAnswers/{answerId} {
      allow create, update: if true;
      allow read: if isAdmin();
    }
  }
}
